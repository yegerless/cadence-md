# Production template. Copy to .env.prod on the server and replace every
# "replace-with-..." value. Never commit .env.prod or real secrets.

# Release / edge
CADENCE_IMAGE_TAG=prod
CADENCE_PUBLIC_HOST=cadence.example.com
NGINX_HTTP_PORT=80
# TLS can be terminated by an external load balancer or by a future nginx TLS override.
NGINX_HTTPS_PORT=443

# Backend process
BACKEND_UVICORN_WORKERS=2
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
AUTH_REGISTER_RATE_LIMIT_IP=10/minute
AUTH_LOGIN_RATE_LIMIT_IP=10/minute
CHAT_RATE_LIMIT_USER=30/minute
GLOBAL_RAG_QUEUE_MAX=1000
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Postgres
POSTGRES_DB=cadence_md
POSTGRES_USER=cadence_md
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql+asyncpg://cadence_md:replace-with-postgres-password@postgres:5432/cadence_md

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_RAG_QUEUE_NAME=rag
CELERY_RAG_TASK_NAME=cadence_md.workers.rag_tasks.run_rag_request
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=360
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
WORKER_LOG_LEVEL=INFO
FLOWER_BIND_HOST=127.0.0.1
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:replace-with-flower-password

# Qdrant
QDRANT_BASE_URL=http://qdrant:6333
QDRANT__SERVICE__API_KEY=replace-with-qdrant-api-key
QDRANT_HTTPS=false

# Inference server mode A: external OpenAI-compatible endpoint.
MODEL_INFERENCE_BASE_URL=https://inference.example.com/v1
MODEL_INFERENCE_API_KEY=replace-with-inference-api-key

# Inference server mode B: optional Docker Compose vLLM profile.
# When running `docker compose --profile inference ...`, use:
# MODEL_INFERENCE_BASE_URL=http://inference-gateway:8080/v1
# Aliases below mirror llama-configs/models-test.ini and app defaults.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_LOGGING_LEVEL=INFO
HF_TOKEN=

# vLLM embeddings service: bge-m3, pooling/embed, ctx-size 4096.
VLLM_EMBEDDINGS_MODEL=BAAI/bge-m3
VLLM_EMBEDDINGS_SERVED_MODEL_NAME=bge-m3
VLLM_EMBEDDINGS_MAX_MODEL_LEN=4096
VLLM_EMBEDDINGS_MAX_NUM_BATCHED_TOKENS=4096
VLLM_EMBEDDINGS_UBATCH_SIZE=2048
VLLM_EMBEDDINGS_GPU_MEMORY_UTILIZATION=0.30
VLLM_EMBEDDINGS_VISIBLE_DEVICES=all
VLLM_EMBEDDINGS_EXTRA_ARGS=

# vLLM reranker service: bge-reranker-v2-m3, pooling/classify or scoring.
VLLM_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VLLM_RERANKER_SERVED_MODEL_NAME=bge-reranker-v2-m3
VLLM_RERANKER_MAX_MODEL_LEN=4096
VLLM_RERANKER_MAX_NUM_BATCHED_TOKENS=4096
VLLM_RERANKER_UBATCH_SIZE=2048
VLLM_RERANKER_GPU_MEMORY_UTILIZATION=0.30
VLLM_RERANKER_VISIBLE_DEVICES=all
VLLM_RERANKER_EXTRA_ARGS=

# vLLM generation service: medgemma, generate runner, ctx-size close to models-test.ini.
# Override VLLM_LLM_MODEL and VLLM_LLM_EXTRA_ARGS for GGUF/checkpoint-specific serving.
VLLM_LLM_MODEL=google/medgemma-4b-it
VLLM_LLM_SERVED_MODEL_NAME=medgemma
VLLM_LLM_MAX_MODEL_LEN=24576
VLLM_LLM_MAX_NUM_BATCHED_TOKENS=2048
VLLM_LLM_UBATCH_SIZE=1024
VLLM_LLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_LLM_VISIBLE_DEVICES=all
VLLM_LLM_EXTRA_ARGS=

# RAG corpus / DVC remote storage
S3_KEY_ID=replace-with-yandex-s3-access-key-id
S3_KEY=replace-with-yandex-s3-secret-access-key
RAG_CORPUS_DIR=/app/data
RAG_CONFIG__QDRANT_CONFIG__DATA_DIR=/app/data/main_specialities

# Frontend build
# Keep this explicitly empty for same-origin /api requests through nginx.
VITE_API_BASE_URL=

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACT_MEDICAL_QUERY=true
PROMETHEUS_ENABLED=true
PROMETHEUS_BIND_HOST=127.0.0.1
PROMETHEUS_PORT=9090
WORKER_METRICS_PORT=9100
PROMETHEUS_MULTIPROC_DIR=/tmp/cadence-prometheus
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
GRAFANA_ROOT_URL=

# Langfuse is disabled by default. Keep medical text redacted unless approved.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=
LANGFUSE_TRACE_QUERY_MODE=redacted
LANGFUSE_PROMPT_VERSION=

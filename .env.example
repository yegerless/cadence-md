# Local development template. Copy to .env.dev and replace placeholders as needed.

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Empty VITE_API_BASE_URL uses the Vite same-origin proxy and avoids CORS in local dev.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://backend:8000
JWT_SECRET=change-me-local-only-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
AUTH_REGISTER_RATE_LIMIT_IP=30/minute
AUTH_LOGIN_RATE_LIMIT_IP=30/minute
CHAT_RATE_LIMIT_USER=30/minute
GLOBAL_RAG_QUEUE_MAX=1000
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cadence_md
POSTGRES_USER=cadence_md
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://cadence_md:change-me-local-only@postgres:5432/cadence_md

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_RAG_QUEUE_NAME=rag
CELERY_RAG_TASK_NAME=cadence_md.workers.rag_tasks.run_rag_request
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=360
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5

# Qdrant
QDRANT_BASE_URL=http://qdrant:6333
QDRANT__SERVICE__API_KEY=change-me-local-only
QDRANT_HTTPS=false

# External OpenAI-compatible inference server. Do not run it from docker-compose-dev.yml.
MODEL_INFERENCE_BASE_URL=http://host.docker.internal:8080/v1
MODEL_INFERENCE_API_KEY=change-me-local-only

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=plain
LOG_REDACT_MEDICAL_QUERY=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
WORKER_METRICS_PORT=9100
PROMETHEUS_MULTIPROC_DIR=/tmp/cadence-prometheus
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Langfuse is disabled by default. Keep real keys in .env.dev only.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=change-me-local-only
LANGFUSE_SECRET_KEY=change-me-local-only
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_TRACE_QUERY_MODE=redacted
LANGFUSE_PROMPT_VERSION=
